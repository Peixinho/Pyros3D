# cmake -DOUTPUT=<file.inc> -DDIR=<dir> -DFILES=a,b,c -P EmbedShaderSources.cmake
# Each file as { "name", { R"P3D(part)P3D", ... } }, - the renderer compiles a material's surface against these at run
# time. In parts of about 8 KB, cut at line ends: MSVC refuses a string literal over 16 KB (C2026), and surface.frag is
# well past that.
cmake_minimum_required(VERSION 3.22)     # (a -P script sets no policies of its own: while() warned, CMP0130)
set(content "")
set(maxParts 16)     # (SceneRenderer.cpp's EmbeddedSource::parts)
string(REPLACE "," ";" FILES "${FILES}")
foreach(f ${FILES})
	file(READ "${DIR}/${f}" rest)
	set(parts "")
	set(count 0)
	while(TRUE)
		string(LENGTH "${rest}" n)
		if(n LESS_EQUAL 8000)
			string(APPEND parts "R\"P3D(${rest})P3D\"")
			math(EXPR count "${count} + 1")
			break()
		endif()
		string(SUBSTRING "${rest}" 8000 -1 tail)
		string(FIND "${tail}" "\n" nl)
		if(nl EQUAL -1)
			set(cut ${n})
		else()
			math(EXPR cut "8000 + ${nl} + 1")
		endif()
		string(SUBSTRING "${rest}" 0 ${cut} part)
		string(APPEND parts "R\"P3D(${part})P3D\", ")
		math(EXPR count "${count} + 1")
		if(cut GREATER_EQUAL n)
			break()
		endif()
		string(SUBSTRING "${rest}" ${cut} -1 rest)
	endwhile()
	if(count GREATER ${maxParts})
		message(FATAL_ERROR "${f} needs ${count} parts of 8 KB; EmbeddedSource holds ${maxParts}")
	endif()
	string(APPEND content "{ \"${f}\", { ${parts} } },\n")
endforeach()
file(WRITE "${OUTPUT}.tmp" "${content}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
